# Template. On Streamlit Cloud paste the live values into Settings -> Secrets.
# Locally you can copy this to secrets.toml (gitignored) or rely on db/.env.

TURSO_DATABASE_URL = "libsql://running-<your-org>.aws-eu-west-1.turso.io"
TURSO_AUTH_TOKEN   = "<paste long-lived token from `turso db tokens create running --expiration none`>"

# Dashboard title (browser tab + login screen).
DASHBOARD_TITLE    = "Running Dashboard"

# Multi-user password gate. Every user has USER<N>_PASSWORD and matching USER<N>_NAME.
# Password -> user_id mapping resolved server-side (no user picker on login screen).
# If NONE of USER*_PASSWORD or APP_PASSWORD is set, dashboard is open (fine for localhost only).
# On Streamlit Cloud always set them — public URL = anyone who guesses it sees data.

# Primary user (user_id=1). Backfill of pre-multitenant data belongs here.
USER1_NAME         = "User 1"
USER1_PASSWORD     = "<choose a strong password>"

# Optional second user (user_id=2). Add rows to the users table via migration or SQL:
#   INSERT INTO users (id, name, display_name, garmin_token_dir) VALUES (2, 'user2', 'User 2', 'user2');
# USER2_NAME       = "User 2"
# USER2_PASSWORD   = "<second user's password>"

# Optional third user (user_id=3) — same pattern.
# USER3_NAME       = "User 3"
# USER3_PASSWORD   = "<third user's password>"

# Legacy single-user password (backwards compat: matches user_id=1).
# APP_PASSWORD     = "<legacy password>"
